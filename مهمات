<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مهام يوسف اليومية</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b132b;
            --card-bg: #1c2541;
            --card-border: #3a506b;
            --text-main: #edf2f4;
            --text-muted: #8d99ae;
            --accent-cyan: #48cae4;
            --accent-teal: #5bc0be;
            --accent-hover: #00b4d8;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --shadow-soft: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding: 24px 16px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 860px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        header {
            text-align: center;
            padding: 12px 0 6px 0;
        }
        header h1 {
            font-size: 2.1rem;
            color: var(--text-main);
            margin-bottom: 8px;
            font-weight: 900;
        }
        .date-badge {
            background: rgba(58, 80, 107, 0.4);
            border: 1px solid var(--card-border);
            padding: 6px 20px;
            border-radius: 30px;
            font-size: 0.95rem;
            color: var(--accent-teal);
            display: inline-block;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 22px;
            box-shadow: var(--shadow-soft);
        }
        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--accent-cyan);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding-bottom: 10px;
        }
        .sync-box {
            background: rgba(72, 202, 228, 0.08);
            border: 1px solid rgba(72, 202, 228, 0.3);
            border-radius: 14px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .sync-box label {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--accent-cyan);
        }
        .sync-input-group {
            display: flex;
            gap: 10px;
        }
        .sync-input-group input {
            flex: 1;
            padding: 10px 14px;
            background: rgba(11, 19, 43, 0.7);
            border: 1px solid var(--card-border);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 0.95rem;
        }
        #tasksList {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .task-item {
            display: flex;
            align-items: center;
            padding: 12px 16px;
            border: 1px solid rgba(58, 80, 107, 0.6);
            background: rgba(11, 19, 43, 0.5);
            border-radius: 12px;
        }
        .task-label {
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            font-size: 1rem;
            width: 100%;
        }
        input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: var(--accent-teal);
        }
        .completed span {
            text-decoration: line-through;
            color: var(--text-muted);
        }
        .subjects-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }
        @media (max-width: 680px) {
            .subjects-grid { grid-template-columns: 1fr; }
        }
        .subject-card {
            background: rgba(11, 19, 43, 0.5);
            border: 1px solid rgba(58, 80, 107, 0.6);
            border-radius: 14px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .subject-header {
            font-weight: 700;
            color: var(--accent-teal);
        }
        .subject-inputs {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .input-group {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(28, 37, 65, 0.7);
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }
        .input-group input {
            width: 55px;
            height: 32px;
            background: var(--bg-color);
            border: 1px solid var(--card-border);
            color: var(--accent-cyan);
            border-radius: 6px;
            text-align: center;
            font-weight: 700;
        }
        .progress-container {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 18px 22px;
        }
        .progress-header {
            display: flex;
            justify-content: space-between;
            font-weight: 700;
        }
        .progress-bar-bg {
            background: var(--bg-color);
            border-radius: 10px;
            height: 12px;
            width: 100%;
            overflow: hidden;
            margin-top: 12px;
        }
        .progress-bar-fill {
            background: linear-gradient(90deg, var(--accent-teal), var(--accent-cyan));
            height: 100%;
            width: 0%;
            transition: width 0.4s ease;
        }
        .actions { display: flex; gap: 12px; }
        button {
            background-color: var(--accent-teal);
            color: #0b132b;
            border: none;
            padding: 12px 18px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-secondary {
            background-color: rgba(58, 80, 107, 0.4);
            color: var(--text-main);
            border: 1px solid var(--card-border);
        }
        .alert-box {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 14px;
            padding: 16px;
            color: #fde68a;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>📋 مهام يوسف اليومية</h1>
        <div class="date-badge" id="currentDate">جاري تحميل التاريخ...</div>
    </header>

    <div class="card sync-box">
        <label for="syncKeyInput">🔗 رمز المزامنة بين الأجهزة:</label>
        <div class="sync-input-group">
            <input type="text" id="syncKeyInput" placeholder="أدخل رمز المزامنة">
            <button onclick="saveSyncKey()">حفظ الرمز</button>
        </div>
    </div>

    <div id="alertBox" class="alert-box" style="display: none;">
        <strong>⚠️ تنبيه نواقص الأمس:</strong> <span id="alertText"></span>
        <div style="margin-top:12px;">
            <button onclick="carryOverTasks()" class="btn-secondary">ترحيل النواقص لجدول اليوم 🔄</button>
        </div>
    </div>

    <div class="progress-container">
        <div class="progress-header">
            <span>مؤشر الإنجاز اليومي</span>
            <span id="progressText" style="color: var(--accent-teal);">0%</span>
        </div>
        <div class="progress-bar-bg">
            <div id="progressBar" class="progress-bar-fill"></div>
        </div>
    </div>

    <div class="card">
        <div class="card-title">📌 المهمات اليومية</div>
        <div id="tasksList"></div>
    </div>

    <div class="card">
        <div class="card-title">📚 متابعة المواد الدراسية</div>
        <div class="subjects-grid" id="subjectsList"></div>
    </div>

    <div class="actions">
        <button style="flex:2;" onclick="saveAndResetDay()">حفظ اليوم والانتقال لليوم الجديد 💾</button>
        <button style="flex:1;" class="btn-secondary" onclick="resetToday()">إعادة ضبط اليوم 🔄</button>
    </div>
</div>

<script>
    const SYNC_KEY_NAME = 'youssef_sync_key';
    let currentSyncKey = localStorage.getItem(SYNC_KEY_NAME) || 'YOUSEF GBR';
    document.getElementById('syncKeyInput').value = currentSyncKey;

    function getStorageKey() {
        return 'youssef_daily_state_' + (localStorage.getItem(SYNC_KEY_NAME) || 'YOUSEF GBR');
    }

    const defaultTasks = [
        { id: 1, text: "4 صفحات قرآن", done: false },
        { id: 2, text: "زيارة آل ياسين", done: false },
        { id: 3, text: "صلاة الليل (أذا أمكن)", done: false },
        { id: 4, text: "درس في الرياضيات + حل 20 سؤال عليه", done: false },
        { id: 5, text: "تقليل استخدام الجوال", done: false }
    ];

    const defaultSubjects = [
        { name: "فيزياء", lessonsDone: 0, lessonsTotal: 10, pagesDone: 0, pagesTotal: 76 },
        { name: "رياضيات", lessonsDone: 0, lessonsTotal: 17, pagesDone: 0, pagesTotal: 83 },
        { name: "كيمياء", lessonsDone: 0, lessonsTotal: 11, pagesDone: 0, pagesTotal: 76 },
        { name: "الأحياء", lessonsDone: 0, lessonsTotal: 11, pagesDone: 0, pagesTotal: 78 }
    ];

    function loadState() {
        return JSON.parse(localStorage.getItem(getStorageKey())) || {
            date: new Date().toLocaleDateString('ar-SA', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }),
            tasks: defaultTasks,
            subjects: defaultSubjects
        };
    }

    let state = loadState();
    document.getElementById('currentDate').innerText = state.date;

    function saveSyncKey() {
        const val = document.getElementById('syncKeyInput').value.trim();
        if (val) {
            localStorage.setItem(SYNC_KEY_NAME, val);
            state = loadState();
            render();
            alert('تم حفظ رمز المزامنة: ' + val);
        }
    }

    function render() {
        const tasksContainer = document.getElementById('tasksList');
        tasksContainer.innerHTML = '';
        state.tasks.forEach((task, index) => {
            tasksContainer.innerHTML += `
                <div class="task-item ${task.done ? 'completed' : ''}">
                    <label class="task-label">
                        <input type="checkbox" ${task.done ? 'checked' : ''} onchange="toggleTask(${index})">
                        <span>${task.text}</span>
                    </label>
                </div>
            `;
        });

        const subjectsContainer = document.getElementById('subjectsList');
        subjectsContainer.innerHTML = '';
        state.subjects.forEach((sub, index) => {
            subjectsContainer.innerHTML += `
                <div class="subject-card">
                    <div class="subject-header"><span>${sub.name}</span></div>
                    <div class="subject-inputs">
                        <div class="input-group">
                            <span>الدروس المنجزة</span>
                            <input type="number" value="${sub.lessonsDone}" onchange="updateSub(${index}, 'lessonsDone', this.value)">
                        </div>
                        <div class="input-group">
                            <span>الصفحات المنجزة</span>
                            <input type="number" value="${sub.pagesDone}" onchange="updateSub(${index}, 'pagesDone', this.value)">
                        </div>
                    </div>
                </div>
            `;
        });

        let totalItems = state.tasks.length + state.subjects.length * 2;
        let completedItems = state.tasks.filter(t => t.done).length;
        state.subjects.forEach(sub => {
            if (sub.lessonsDone >= sub.lessonsTotal) completedItems++;
            if (sub.pagesDone >= sub.pagesTotal) completedItems++;
        });

        let percent = Math.round((completedItems / totalItems) * 100);
        document.getElementById('progressBar').style.width = percent + '%';
        document.getElementById('progressText').innerText = percent + '%';
        localStorage.setItem(getStorageKey(), JSON.stringify(state));
    }

    function toggleTask(index) {
        state.tasks[index].done = !state.tasks[index].done;
        render();
    }

    function updateSub(index, field, val) {
        state.subjects[index][field] = Math.max(0, Number(val));
        render();
    }

    render();
</script>
</body>
</html>
